# Copy to .allaboard-migration/phase1/dokploy-api.env (gitignored)
# Pretorya org on Dokploy Cloud — Settings → Profile → API Keys

DOKPLOY_URL=https://app.dokploy.com/api
DOKPLOY_API_KEY=

# Optional — only for pretorya-phase1-provision.mjs (remote deploy server)
# DOKPLOY_SERVER_NAME=allaboard-pretorya
# DOKPLOY_SERVER_IP=
# DOKPLOY_SERVER_SSH_PORT=22
# DOKPLOY_SERVER_SSH_USER=root
# DOKPLOY_SERVER_SSH_KEY_ID=
