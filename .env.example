# URL interne pour le serveur Next uniquement (SSR, Server Actions, Route Handlers).
# En local : API sur 127.0.0.1:4000. Sur Dokploy : nom DNS interne du service API + port 4000.
# Ne pas utiliser de prefixe NEXT_PUBLIC_ (non expose au bundle client).
API_URL=http://127.0.0.1:4000

# Origine publique HTTPS de l'API pour le navigateur (useQuery client direct vers Fastify).
# Non requis si le client appelle uniquement un Route Handler Next (BFF), ex. GET /api/feed.
# Voir Docs/deploiement-dokploy-instance-allaboard.md
# NEXT_PUBLIC_API_URL=

# API Fastify
PORT=4000
HOST=0.0.0.0

# Avatar uploads — local disk storage served by API at /uploads/avatars/
# AVATAR_STORAGE_DIR=data/uploads/avatars
# Public URL prefix for avatarUrl stored in DB (required behind reverse proxy in prod)
# AVATAR_PUBLIC_BASE_URL=http://127.0.0.1:4000/uploads/avatars

# Agent All-Aboard (interne — Phase 4, port 4100 ; distinct de Rubberduck externe)
# AGENT_URL=http://127.0.0.1:4100

# Rubberduck (service externe — redirect web après handoff agent #68)
# RUBBERDUCK_URL=https://rubberduck.example/help

# Bridge Intuition (#67) — publisher outbox dans le processus API
# INTUITION_RPC_URL=
# INTUITION_API_KEY=
# INTUITION_GRAPHQL_URL=
# INTUITION_NETWORK_ID=
# INTUITION_PUBLISHER_ENABLED=true
# INTUITION_PUBLISHER_POLL_MS=5000

# Postgres (API). Local : `docker compose up -d` puis URL ci-dessous. Dokploy : service interne + port 5432.
# DATABASE_URL=postgresql://allaboard:allaboard@127.0.0.1:5432/allaboard

# Auth API (ADR Docs/adr/0001-authentication-strategy.md)
# JWT_SECRET=change-me-in-dev
# Seed dev/CI : hash des comptes bob@dev.local / alice@dev.local (voir ADR 0003).
# DEV_SEED_PASSWORD=dev-only-password
# Fallback login sans DB (dev local uniquement) — corps legacy { "userId", "password" }.
# MVP_LOGIN_PASSWORD=dev-only-password
# Identifiants recevant role mentor au login (CSV). Defaut API : alice
# MVP_MENTOR_USER_IDS=alice

# Google OAuth (ADR Docs/adr/0006-oauth-google-sso.md) — API uniquement
# GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=
# URI callback BFF (exact match Google Console redirect URI)
# OAUTH_GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
# Origine web pour redirects post-login OAuth
# WEB_APP_URL=http://localhost:3000
