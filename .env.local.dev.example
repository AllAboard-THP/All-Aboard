# Local API env (gitignored copy: `.env.local.dev` at repo root).
# Setup: cp .env.local.dev.example .env.local.dev && docker compose up -d
#
# Used by: pnpm dev:local, pnpm test, pnpm verify (auto-loaded when present), pnpm test:e2e
# CI uses its own DATABASE_URL (allaboard_test); local Docker uses DB `allaboard`.

DATABASE_URL=postgresql://allaboard:allaboard@127.0.0.1:5432/allaboard
JWT_SECRET=dev-only-jwt-secret-min-32-characters!!
MVP_LOGIN_PASSWORD=dev-only-password
DEV_SEED_PASSWORD=dev-only-password
